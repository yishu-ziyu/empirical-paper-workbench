# econpaper backend environment variables (copy to .env and fill in)

# --- App ---
DEBUG=false

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- LangGraph checkpointing ---
CHECKPOINT_DB_URL=sqlite:///./checkpoints.sqlite

# --- Database (user auth) ---
# SQLite for development; postgresql+asyncpg://user:pass@host/db for production
DATABASE_URL=sqlite+aiosqlite:///./econpaper.db

# --- JWT ---
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- LLM ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- ADR-0008: 多 LLM 路由（评审 LLM 与生成 LLM 使用不同模型） ---
# 生成节点（generate_chapter / generate_title / generate_outline）
GENERATE_LLM_PROVIDER=mock
GENERATE_LLM_MODEL=default
GENERATE_LLM_API_KEY=
# 评审节点（review_chapter）
REVIEW_LLM_PROVIDER=mock
REVIEW_LLM_MODEL=default
REVIEW_LLM_API_KEY=

# --- S3 / Object Storage (MinIO for dev, AWS/OSS/COS for prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=econpaper-uploads
S3_PATH_PREFIX=uploads/
S3_CACHE_DIR=./uploads/.s3_cache

# --- HTTP client ---
HTTPX_TIMEOUT_SECONDS=30.0

# --- ADR-0004 Stage 4: Semantic Scholar API ---
# 可选。缺失时 literature_source=semantic_scholar 自动降级为 mock_degraded。
# 无 key 时 API 受 rate limit（100 次/5分钟）；有 key 时更高。
SEMANTIC_SCHOLAR_API_KEY=
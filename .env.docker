# econpaper Docker 环境变量
# cp .env.docker .env  然后把所有 SET_ME 换成随机值后再 compose up

DEBUG=false
CORS_ORIGINS=http://localhost

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

POSTGRES_USER=econpaper
POSTGRES_PASSWORD=SET_ME
POSTGRES_DB=econpaper

CHECKPOINT_DB_URL=postgresql://econpaper:SET_ME@postgres:5432/econpaper
DATABASE_URL=postgresql+asyncpg://econpaper:SET_ME@postgres:5432/econpaper

JWT_SECRET_KEY=SET_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

MINIO_ROOT_USER=SET_ME
MINIO_ROOT_PASSWORD=SET_ME

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

GENERATE_LLM_PROVIDER=mock
GENERATE_LLM_MODEL=default
GENERATE_LLM_API_KEY=
REVIEW_LLM_PROVIDER=mock
REVIEW_LLM_MODEL=default
REVIEW_LLM_API_KEY=

HTTPX_TIMEOUT_SECONDS=30.0
SEMANTIC_SCHOLAR_API_KEY=

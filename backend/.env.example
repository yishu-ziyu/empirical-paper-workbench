# econpaper backend environment variables (copy to .env and fill in)

# --- App ---
DEBUG=false

# --- CORS ---
# Comma-separated list of allowed origins.
# Comma-separated list of allowed origins. Local Vite also matches
# CORS_ORIGIN_REGEX (localhost / 127.0.0.1 on any port). The desk uses a
# same-origin /api proxy so a preview on :5174 does not CORS-fail.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- LangGraph checkpointing ---
CHECKPOINT_DB_URL=sqlite:///./checkpoints.sqlite

# --- Database (user auth) ---
# SQLite for development; postgresql+asyncpg://user:pass@host/db for production
DATABASE_URL=sqlite+aiosqlite:///./econpaper.db

# --- JWT ---
# Production refuses missing/short/published defaults. Use a random 32+ char secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- LLM ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- ADR-0008: 多 LLM 路由 ---
# 留空则用本机 MiniMax SSOT（~/.config/ai-providers）。
# pytest 自动 mock。关真模型：ECONPAPER_LLM=mock
# GENERATE_LLM_PROVIDER=minimax
# GENERATE_LLM_MODEL=MiniMax-M3
# GENERATE_LLM_API_KEY=
# REVIEW_LLM_PROVIDER=minimax
# REVIEW_LLM_MODEL=MiniMax-M3
# REVIEW_LLM_API_KEY=

# --- S3 / Object Storage (MinIO for dev, AWS/OSS/COS for prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=econpaper-uploads
S3_PATH_PREFIX=uploads/
S3_CACHE_DIR=./uploads/.s3_cache

# --- HTTP client ---
HTTPX_TIMEOUT_SECONDS=30.0

# --- ADR-0004 Stage 4: Semantic Scholar API ---
# 可选。缺失时 literature_source=semantic_scholar 自动降级为 mock_degraded。
# 无 key 时 API 受 rate limit（100 次/5分钟）；有 key 时更高。
SEMANTIC_SCHOLAR_API_KEY=
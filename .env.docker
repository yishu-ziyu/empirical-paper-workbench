# ============================================================
# econpaper Docker 环境变量
# 复制为 .env 后 docker compose up 会自动读取
# cp .env.docker .env  # 编辑后启动
# ============================================================

# --- App ---
DEBUG=false

# --- CORS（生产环境替换为实际域名） ---
CORS_ORIGINS=http://localhost

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# --- LangGraph checkpointing (PostgreSQL) ---
CHECKPOINT_DB_URL=postgresql://econpaper:econpaper_pass@postgres:5432/econpaper

# --- Database (user auth) ---
DATABASE_URL=postgresql+asyncpg://econpaper:econpaper_pass@postgres:5432/econpaper

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- LLM ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- 多 LLM 路由 ---
GENERATE_LLM_PROVIDER=mock
GENERATE_LLM_MODEL=default
GENERATE_LLM_API_KEY=
REVIEW_LLM_PROVIDER=mock
REVIEW_LLM_MODEL=default
REVIEW_LLM_API_KEY=

# --- HTTP client ---
HTTPX_TIMEOUT_SECONDS=30.0

# --- Semantic Scholar ---
SEMANTIC_SCHOLAR_API_KEY=

# --- PostgreSQL (docker-compose 使用) ---
POSTGRES_USER=econpaper
POSTGRES_PASSWORD=econpaper_pass
POSTGRES_DB=econpaper
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatspAI Workflow IO",
  "type": "object",
  "required": [
    "version",
    "workflow_id",
    "run_id",
    "project",
    "inputs",
    "outputs",
    "gates",
    "status",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[0-9]{2}_[a-z0-9_]+$"
    },
    "run_id": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": ["name", "root"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "root": {"type": "string"},
        "dataset": {"type": "string"},
        "paper_id": {"type": "string"}
      }
    },
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/definitions/artifact"}
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/definitions/artifact"}
    },
    "gates": {
      "type": "array",
      "items": {"$ref": "#/definitions/gate"}
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "partial", "blocked"]
    },
    "failure": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "rollback_to": {"type": ["string", "null"]}
      }
    },
    "human_checkpoints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/definitions/evidence"}
    },
    "provenance": {
      "type": "object",
      "required": ["created_at", "created_by"],
      "additionalProperties": false,
      "properties": {
        "created_at": {"type": "string"},
        "created_by": {"type": "string"},
        "source_registry": {"type": "string"},
        "commands": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "required": ["name", "path", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "path": {"type": "string"},
        "required": {"type": "boolean"},
        "status": {
          "type": "string",
          "enum": ["present", "missing", "partial", "external"]
        },
        "note": {"type": "string"}
      }
    },
    "gate": {
      "type": "object",
      "required": ["name", "type", "status"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "type": {
          "type": "string",
          "enum": ["automated", "human"]
        },
        "command": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "partial", "blocked"]
        },
        "evidence_path": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["claim", "path"],
      "additionalProperties": false,
      "properties": {
        "claim": {"type": "string"},
        "path": {"type": "string"},
        "span": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  }
}

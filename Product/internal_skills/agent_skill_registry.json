{
  "schema_version": "internal_agent_skill_registry.v1",
  "status": "active",
  "description": "Product-native Agent Skill contracts adapted from proven empirical-research skill ecosystems.",
  "canonical_policy": {
    "mode": "internal_draft_until_human_review",
    "auto_write_canonical": false,
    "proposal_path": "Program/methodology/proposals/internal-agent-skills/"
  },
  "skills": [
    {
      "id": "recursive_research_search",
      "lifecycle": "internal_draft",
      "metadata": {
        "name": "递归研究搜索",
        "domain": "literature",
        "owner_agent": "LiteratureAgent",
        "allowed_agents": ["Supervisor", "LiteratureAgent", "ReviewerAgent"],
        "risk_level": "medium",
        "evidence_level": "web_and_local_source",
        "source_policy": "external_reference_normalized"
      },
      "applies_when": {
        "stage": "recursive_search",
        "required_state": ["TaskBrief.approved"],
        "blockers": ["missing_research_question"]
      },
      "inputs": {
        "required": ["research_question", "boundary_terms"],
        "optional": ["seed_literature", "dataset_hints", "method_preferences"]
      },
      "outputs": {
        "artifacts": ["LiteratureSeedPackage", "search_query_graph", "verification_queue"],
        "state_patch_proposal": ["LiteratureSearchPlan"],
        "formal_write_targets": []
      },
      "tools": {
        "allowed_adapters": ["web_search", "cnki_manual_assist", "zotero_optional", "local_notes_search"],
        "forbidden_actions": ["write_formal_literature_review_without_verified_citations"]
      },
      "quality_gates": {
        "machine_checkable": ["aers:eval:citation-hygiene-no-fake-refs"],
        "manual_review": ["source_relevance_review", "chinese_literature_gap_review"]
      },
      "human_confirmation": {
        "required_before": ["formal_literature_review_writeback"],
        "approver_role": "human_researcher"
      },
      "failure_conditions": {
        "hard_fail": ["citation_not_verifiable", "search_topic_drift"],
        "soft_warn": ["english_only_search_results", "no_dataset_link_found"]
      },
      "provenance": {
        "external_sources": [
          {
            "name": "Auto-Empirical-Research-Skills",
            "url": "https://github.com/brycewang-stanford/Auto-Empirical-Research-Skills",
            "license": "CC-BY-SA-4.0"
          },
          {
            "name": "Maigret",
            "url": "https://github.com/soxoj/maigret",
            "license": "MIT"
          }
        ],
        "attribution": "Adapted into an academic evidence graph workflow.",
        "transformation_log": [
          "Converted recursive search from account discovery into topic -> literature -> data -> method -> missing evidence loops."
        ]
      },
      "benchmark": {
        "eval_scenarios": ["citation-hygiene-no-fake-refs"],
        "numeric_tasks": [],
        "pass_policy": "manual_open_items_block_formal_writeback"
      }
    },
    {
      "id": "did_staggered_identification_gate",
      "lifecycle": "internal_draft",
      "metadata": {
        "name": "交错 DID 识别门",
        "domain": "method",
        "owner_agent": "MethodAgent",
        "allowed_agents": ["Supervisor", "MethodAgent", "ExecutionAgent", "ReviewerAgent"],
        "risk_level": "high",
        "evidence_level": "method_gate",
        "source_policy": "external_reference_normalized"
      },
      "applies_when": {
        "stage": "method_design",
        "required_state": ["VariableRoleSet.approved", "DesignSpec.draft"],
        "blockers": ["missing_treatment_timing", "missing_panel_index"]
      },
      "inputs": {
        "required": ["unit_id", "time_id", "treatment_timing", "outcome", "controls"],
        "optional": ["event_window", "cluster_level", "comparison_group"]
      },
      "outputs": {
        "artifacts": ["did_readiness_report", "twfe_risk_report", "estimator_proposal"],
        "state_patch_proposal": ["DesignSpec.method_patch", "RunPlan.estimator_patch"],
        "formal_write_targets": []
      },
      "tools": {
        "allowed_adapters": ["statspai", "python_pyfixest", "stata_mcp_optional"],
        "forbidden_actions": ["run_twfe_as_default_when_staggered_treatment_is_detected"]
      },
      "quality_gates": {
        "machine_checkable": ["aers:eval:did-staggered-recovery", "aers:benchmark:staggered-did-recovery"],
        "manual_review": ["parallel_trends_substantive_review", "treatment_timing_validity_review"]
      },
      "human_confirmation": {
        "required_before": ["default_run_plan_inclusion", "formal_method_writeback"],
        "approver_role": "human_researcher"
      },
      "failure_conditions": {
        "hard_fail": ["staggered_treatment_detected_without_modern_did_estimator", "post_treatment_control_detected"],
        "soft_warn": ["limited_pre_treatment_periods", "small_number_of_treated_units"]
      },
      "provenance": {
        "external_sources": [
          {
            "name": "AER-Skills",
            "url": "https://github.com/brycewang-stanford/AER-skills",
            "license": "pending_human_license_review"
          },
          {
            "name": "Auto-Empirical-Research-Skills benchmark",
            "url": "https://github.com/brycewang-stanford/Auto-Empirical-Research-Skills",
            "license": "CC-BY-SA-4.0"
          },
          {
            "name": "StatsPAI",
            "url": "https://github.com/brycewang-stanford/StatsPAI",
            "license": "MIT"
          }
        ],
        "attribution": "Adapted into a DID method gate for this empirical OS.",
        "transformation_log": [
          "Mapped AER-like staggered DID checklist and AERS benchmark into DesignSpec/RunPlan proposal gates."
        ]
      },
      "benchmark": {
        "eval_scenarios": ["did-staggered-recovery"],
        "numeric_tasks": ["staggered-did-recovery"],
        "pass_policy": "required_gold_and_manual_items_before_default_run_plan"
      }
    },
    {
      "id": "weak_iv_diagnostic_gate",
      "lifecycle": "internal_draft",
      "metadata": {
        "name": "弱工具变量诊断门",
        "domain": "method",
        "owner_agent": "MethodAgent",
        "allowed_agents": ["Supervisor", "MethodAgent", "ExecutionAgent", "ReviewerAgent"],
        "risk_level": "high",
        "evidence_level": "method_gate",
        "source_policy": "external_reference_normalized"
      },
      "applies_when": {
        "stage": "method_design",
        "required_state": ["VariableRoleSet.approved", "DesignSpec.draft"],
        "blockers": ["missing_instrument", "missing_first_stage"]
      },
      "inputs": {
        "required": ["outcome", "endogenous_variable", "instrument", "controls"],
        "optional": ["cluster_level", "fixed_effects", "first_stage_result"]
      },
      "outputs": {
        "artifacts": ["weak_iv_report", "first_stage_diagnostics", "robust_inference_requirement"],
        "state_patch_proposal": ["DesignSpec.identification_patch", "RunPlan.robust_inference_patch"],
        "formal_write_targets": []
      },
      "tools": {
        "allowed_adapters": ["statspai", "python_linearmodels", "stata_mcp_optional"],
        "forbidden_actions": ["accept_2sls_without_instrument_strength_report"]
      },
      "quality_gates": {
        "machine_checkable": ["aers:eval:statspai-weak-iv", "aers:benchmark:card-iv-recovery"],
        "manual_review": ["exclusion_restriction_review", "instrument_relevance_substantive_review"]
      },
      "human_confirmation": {
        "required_before": ["default_run_plan_inclusion", "formal_method_writeback"],
        "approver_role": "human_researcher"
      },
      "failure_conditions": {
        "hard_fail": ["weak_first_stage_without_robust_inference", "no_exclusion_restriction_argument"],
        "soft_warn": ["single_instrument_only", "limited_overidentification_checks"]
      },
      "provenance": {
        "external_sources": [
          {
            "name": "AER-Skills",
            "url": "https://github.com/brycewang-stanford/AER-skills",
            "license": "pending_human_license_review"
          },
          {
            "name": "Auto-Empirical-Research-Skills benchmark",
            "url": "https://github.com/brycewang-stanford/Auto-Empirical-Research-Skills",
            "license": "CC-BY-SA-4.0"
          },
          {
            "name": "StatsPAI",
            "url": "https://github.com/brycewang-stanford/StatsPAI",
            "license": "MIT"
          }
        ],
        "attribution": "Adapted into an IV diagnostic gate for this empirical OS.",
        "transformation_log": [
          "Mapped AERS weak-IV eval and Card benchmark into method gate proposal contract."
        ]
      },
      "benchmark": {
        "eval_scenarios": ["statspai-weak-iv"],
        "numeric_tasks": ["card-iv-recovery"],
        "pass_policy": "required_gold_and_manual_items_before_default_run_plan"
      }
    },
    {
      "id": "aer_abstract_submission_preflight",
      "lifecycle": "internal_draft",
      "metadata": {
        "name": "AER-like 投稿预检",
        "domain": "review",
        "owner_agent": "ReviewerAgent",
        "allowed_agents": ["Supervisor", "ReviewerAgent", "ManuscriptAgent", "ExportAgent"],
        "risk_level": "medium",
        "evidence_level": "local_file",
        "source_policy": "venue_standard_normalized"
      },
      "applies_when": {
        "stage": "review_export",
        "required_state": ["ManuscriptDraft.generated", "EvidenceBindings.available"],
        "blockers": ["missing_abstract", "missing_table_figure_notes"]
      },
      "inputs": {
        "required": ["abstract", "manuscript_sections", "table_figure_manifest", "disclosure_notes"],
        "optional": ["target_journal", "cover_letter"]
      },
      "outputs": {
        "artifacts": ["submission_preflight_report", "abstract_length_report", "table_figure_style_report"],
        "state_patch_proposal": ["Manuscript.revision_work_orders"],
        "formal_write_targets": []
      },
      "tools": {
        "allowed_adapters": ["local_markdown_parser", "docx_preflight", "latex_preflight"],
        "forbidden_actions": ["submit_or_export_formal_package_without_human_approval"]
      },
      "quality_gates": {
        "machine_checkable": ["aers:eval:aer-abstract-100words", "aers:eval:aer-tables-figures-housestyle"],
        "manual_review": ["contribution_claim_review", "ai_usage_disclosure_review"]
      },
      "human_confirmation": {
        "required_before": ["formal_submission_package_export"],
        "approver_role": "human_researcher"
      },
      "failure_conditions": {
        "hard_fail": ["abstract_over_limit_for_selected_venue", "unbound_table_or_figure"],
        "soft_warn": ["target_journal_not_selected", "cover_letter_missing"]
      },
      "provenance": {
        "external_sources": [
          {
            "name": "AER-Skills",
            "url": "https://github.com/brycewang-stanford/AER-skills",
            "license": "pending_human_license_review"
          },
          {
            "name": "Auto-Empirical-Research-Skills eval harness",
            "url": "https://github.com/brycewang-stanford/Auto-Empirical-Research-Skills",
            "license": "CC-BY-SA-4.0"
          }
        ],
        "attribution": "Adapted into a venue preflight checklist.",
        "transformation_log": [
          "Converted AER-style abstract/submission checks into review/export gate proposals."
        ]
      },
      "benchmark": {
        "eval_scenarios": ["aer-abstract-100words", "aer-submission-preflight", "aer-tables-figures-housestyle"],
        "numeric_tasks": [],
        "pass_policy": "manual_open_items_block_formal_export"
      }
    },
    {
      "id": "replication_package_gate",
      "lifecycle": "internal_draft",
      "metadata": {
        "name": "复现包质量门",
        "domain": "reproducibility",
        "owner_agent": "ReproAgent",
        "allowed_agents": ["Supervisor", "ReproAgent", "ExecutionAgent", "VerifierAgent", "ReviewerAgent"],
        "risk_level": "high",
        "evidence_level": "local_execution",
        "source_policy": "external_reference_normalized"
      },
      "applies_when": {
        "stage": "review_export",
        "required_state": ["MethodExecutionResult.available", "ArtifactManifest.available"],
        "blockers": ["missing_run_manifest", "missing_environment_manifest"]
      },
      "inputs": {
        "required": ["run_manifest", "artifact_manifest", "analysis_scripts", "environment_manifest"],
        "optional": ["paper_pdf", "replication_package"]
      },
      "outputs": {
        "artifacts": ["reproducibility_report", "one_command_reproduce", "environment_lock_report"],
        "state_patch_proposal": ["ExportPreflight.reproducibility_patch"],
        "formal_write_targets": []
      },
      "tools": {
        "allowed_adapters": ["local_python", "git_status", "artifact_manifest_reader"],
        "forbidden_actions": ["modify_raw_data", "delete_failed_logs"]
      },
      "quality_gates": {
        "machine_checkable": ["product:cap_reproducibility_contract", "aers:eval:replication-package-readme"],
        "manual_review": ["replication_readme_review", "data_availability_review"]
      },
      "human_confirmation": {
        "required_before": ["formal_package_export", "public_release"],
        "approver_role": "human_researcher"
      },
      "failure_conditions": {
        "hard_fail": ["raw_data_modified", "one_command_reproduction_missing", "artifact_without_script"],
        "soft_warn": ["dirty_git_status", "large_untracked_artifacts"]
      },
      "provenance": {
        "external_sources": [
          {
            "name": "AER-Skills replication workflow",
            "url": "https://github.com/brycewang-stanford/AER-skills",
            "license": "pending_human_license_review"
          },
          {
            "name": "AEADataEditor replication-template",
            "url": "https://github.com/AEADataEditor/replication-template",
            "license": "pending_human_license_review"
          },
          {
            "name": "Auto-Empirical-Research-Skills",
            "url": "https://github.com/brycewang-stanford/Auto-Empirical-Research-Skills",
            "license": "CC-BY-SA-4.0"
          }
        ],
        "attribution": "Adapted into product reproducibility quality gate.",
        "transformation_log": [
          "Mapped replication package practices into review/export preflight and product reproducibility contract."
        ]
      },
      "benchmark": {
        "eval_scenarios": ["replication-package-readme", "citation-hygiene-no-fake-refs"],
        "numeric_tasks": [],
        "pass_policy": "hard_fail_blocks_formal_export"
      }
    }
  ]
}

CREATE TABLE runs (
	run_id VARCHAR(36) NOT NULL, 
	session_id VARCHAR(64) NOT NULL, 
	kind VARCHAR(64) NOT NULL, 
	status VARCHAR(24) NOT NULL, 
	payload JSON NOT NULL, 
	result JSON, 
	error TEXT, 
